# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.production
.env.*.local
# Allow .env.example to be committed
!.env.example

# Cycle 1.2a local smoke artifacts (never commit)
scripts/.cycle12a-pass2-manifest.json
scripts/.cycle12a-pass2-smoke-report.json
scripts/.cycle12a-pass2-server-*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# documentation and reference files
reference/

# ignore folder
.ignore/
ocr-service/logs/
ocr-service/outputs/
ocr-service/__pycache__/
ocr-service/ocr/__pycache__/
ocr-service/engine/__pycache__/
ocr-service/validation/__pycache__/
ocr-service/validation/images/
ocr-service/validation/accuracy_report.json

# Local QA / smoke / probe outputs (never commit)
/tmp/

# One-off local generator scripts
scripts/_tmp_*
