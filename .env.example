
# ===========================================
# NAVADRISHTI ENVIRONMENT CONFIGURATION
# ===========================================
# Copy to .env.local. On Vercel, set the same keys in project settings.
# For go-live, point the Supabase trio at the production project (the one with
# RLS) and run supabase/rls-lockdown.sql there. Do not put the secret key in
# any NEXT_PUBLIC_* variable.

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# SUPABASE CONFIGURATION (Primary Database)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ===========================================
# CLOUDINARY CONFIGURATION (Image Upload)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CRON_SECRET=your_cron_secret_here

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ===========================================
# CA CONSOLE CONFIGURATION
# ===========================================
# NOTE: CA accounts (including CA ID and credentials) are created by admin via Admin UI
# No env-based CA credentials needed anymore
CA_JWT_EXPIRES_IN=12h

# ===========================================
# PAYMENT CONFIGURATION (RAZORPAY)
# ===========================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_LOGO_URL=https://app.navadrishti.in/photos/razorpay-logo.png
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=5
NEXT_PUBLIC_PLATFORM_FEE_MIN_INR=10
NEXT_PUBLIC_PLATFORM_GST_PERCENT=18
# Optional server-only fallbacks; use the NEXT_PUBLIC_* values above instead.
# PLATFORM_FEE_PERCENT=5
# PLATFORM_FEE_MIN_INR=10
# PLATFORM_GST_PERCENT=18
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# AI CONFIGURATION
# ===========================================
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: set to 1 to enable local live Gemini integration tests (never commit a real key).
# NAVADRISHTI_LIVE_GEMINI=1

# ===========================================
# SMS CONFIGURATION (optional; required for phone OTP delivery)
# ===========================================
MSG91_API_KEY=
MSG91_TEMPLATE_ID=

# ===========================================
# SHIPPING CONFIGURATION (DELHIVERY)
# ===========================================
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
# production (default) or staging; DELHIVERY_API_BASE_URL overrides both
DELHIVERY_ENV=production
DELHIVERY_API_BASE_URL=
DELHIVERY_API_TIMEOUT_MS=10000

# ===========================================
# FIELD / GRAM APP (separately hosted PWA)
# ===========================================
# Public URL used by the platform's GRAM App link.
NEXT_PUBLIC_PWA_URL=https://field.example.com
# Server-side URL used by /api/pwa/* to proxy field-app APIs.
# Falls back to NEXT_PUBLIC_PWA_URL when unset.
PWA_UPSTREAM_URL=https://field.example.com
# Extra browser origin allowed to call /api/pwa/* (optional; NEXT_PUBLIC_PWA_URL is already allowed).
PWA_CORS_ORIGIN=

# ===========================================
# CSR AGENT — ABUSE PROTECTION (not product quota)
# ===========================================
# Product quota / pricing tiers are UNDEFINED. These env vars only throttle
# Gemini draft generation per authenticated company user (anti-abuse).
# Shared Postgres auth_rate_limit_hit is required outside tests; when the RPC
# is unavailable, CSR generate fails closed (429) unless the local escape below
# is set. Do not enable the escape on multi-instance deployments.
# CSR_AGENT_GENERATE_ABUSE_LIMIT=30
# CSR_AGENT_GENERATE_ABUSE_WINDOW_MS=3600000
# CSR_AGENT_GENERATE_ALLOW_MEMORY_LIMIT=0
# RATE_LIMIT_FAIL_CLOSED=0

# ===========================================
# KYC DOCUMENT CONFIDENTIALITY (Cycle 1.2a)
# ===========================================
# Server-side only. Default off so existing public KYC uploads keep working.
# Set both to 1 together after Cloudinary authenticated delivery is confirmed.
# KYC_AUTHENTICATED_UPLOAD=1
#   New /api/verification/upload assets use Cloudinary type=authenticated and
#   return ndkyc document refs (no durable public secure_url).
# KYC_CONTENT_PROXY=1
#   Enables GET /api/verification/documents/[id]/file after owner/CA/admin authZ.
# KYC_AUTHENTICATED_UPLOAD=0
# KYC_CONTENT_PROXY=0

# ===========================================
# POSTGRES INTEGRATION TESTS (local disposable DB only)
# ===========================================
# Do NOT commit a real value. Do NOT point at navadrishti-dev or navadrishti-prod.
# Required database name: navadrishti_cycle11_test
# Required host: localhost / 127.0.0.1 / ::1
# Example (set in your private shell or untracked .env — never commit):
# NAVADRISHTI_PG_TEST_URL=postgresql://USER@127.0.0.1:5432/navadrishti_cycle11_test
# Set to 1 in CI so a missing URL fails instead of skipping the PG suite:
# NAVADRISHTI_PG_TEST_REQUIRED=1

