
# ===========================================
# GRAM ENVIRONMENT CONFIGURATION
# ===========================================
# Single comprehensive environment file for all configurations

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
APP_URL=http://localhost:3000

# ===========================================
# SUPABASE CONFIGURATION (Primary Database)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ===========================================
# CLOUDINARY CONFIGURATION (Image Upload - WORKING)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CRON_SECRET=your_cron_secret_here

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ===========================================
# CA CONSOLE CONFIGURATION
# ===========================================
# NOTE: CA accounts (including CA ID and credentials) are created by admin via Admin UI
# No env-based CA credentials needed anymore
CA_JWT_EXPIRES_IN=12h

# LAUNCH PHASE (soft launch gating)
NEXT_PUBLIC_LAUNCH_PHASE=1

# ===========================================
# DONATION PAYMENT CONFIGURATION (RAZORPAY)
# ===========================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_LOGO_URL=https://app.navadrishti.in/photos/razorpay-logo.png
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=2
NEXT_PUBLIC_PLATFORM_FEE_MIN_INR=10
NEXT_PUBLIC_PLATFORM_GST_PERCENT=18
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# LLM CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL="https://app.navadrishti.in"

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_API_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TIMEOUT_MS=10000
DELHIVERY_PICKUP_LOCATION_NAME=your_registered_warehouse_name

# Field / GRAM App (separately hosted PWA)
# NEXT_PUBLIC_PWA_URL=https://app.example.com  # enables "Download the GRAM App" in the platform sidebar
# PWA_UPSTREAM_URL=https://app.example.com     # optional API gateway proxy
