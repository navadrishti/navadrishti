
# ===========================================
# GRAM ENVIRONMENT CONFIGURATION
# ===========================================
# Single comprehensive environment file for all configurations

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# SUPABASE CONFIGURATION (Primary Database)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ===========================================
# CLOUDINARY CONFIGURATION (Image Upload)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CRON_SECRET=your_cron_secret_here

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ===========================================
# CA CONSOLE CONFIGURATION
# ===========================================
# NOTE: CA accounts (including CA ID and credentials) are created by admin via Admin UI
# No env-based CA credentials needed anymore
CA_JWT_EXPIRES_IN=12h

# ===========================================
# PAYMENT CONFIGURATION (RAZORPAY)
# ===========================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_LOGO_URL=https://app.navadrishti.in/photos/razorpay-logo.png
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=5
NEXT_PUBLIC_PLATFORM_FEE_MIN_INR=10
NEXT_PUBLIC_PLATFORM_GST_PERCENT=18
# Optional server-only fallbacks; use the NEXT_PUBLIC_* values above instead.
# PLATFORM_FEE_PERCENT=5
# PLATFORM_FEE_MIN_INR=10
# PLATFORM_GST_PERCENT=18
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# AI CONFIGURATION
# ===========================================
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ===========================================
# SMS CONFIGURATION (optional; required for phone OTP delivery)
# ===========================================
MSG91_API_KEY=
MSG91_TEMPLATE_ID=

# ===========================================
# SHIPPING CONFIGURATION (DELHIVERY)
# ===========================================
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
# production (default) or staging; DELHIVERY_API_BASE_URL overrides both
DELHIVERY_ENV=production
DELHIVERY_API_BASE_URL=
DELHIVERY_API_TIMEOUT_MS=10000

# ===========================================
# FIELD / GRAM APP (separately hosted PWA)
# ===========================================
# Public URL used by the platform's GRAM App link.
NEXT_PUBLIC_PWA_URL=https://field.example.com
# Server-side URL used by /api/pwa/* to proxy field-app APIs.
PWA_UPSTREAM_URL=https://field.example.com
